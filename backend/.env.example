# Copy to backend/.env and adjust values; you can also set these via docker-compose environment

# Auth/JWT
SECRET_KEY=change-me
ALGORITHM=HS256
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
USER_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DB (use either DATABASE_URL or host/port/user/pass)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/VITBOT?sslmode=disable
DB_HOST=db
DB_PORT=5432
DB_NAME=VITBOT
DB_USER=postgres
DB_PASSWORD=postgres

# External APIs (optional)
GROQ_API_KEY=

# App runtime
HOST=0.0.0.0
PORT=8000
WORKERS=1
